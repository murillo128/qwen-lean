    {"id": "riemann-hypothesis", "canonical_name": "Riemann hypothesis", "display_name": "Riemann hypothesis", "aliases": ["RH"], "statement": "Every nontrivial zero of the Riemann zeta function has real part 1/2.", "authors": ["Bernhard Riemann"], "year": 1859, "source_ids": ["riemann-1859", "bombieri-rh"], "relationship_to_rh": {"class": "definition/foundation", "direction": "identity", "source_ids": ["riemann-1859"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["zeta-zeros", "RH"], "formalization_status": "literature-only", "formalization": null, "verification_status": "open-conjecture", "candidate_role": "knowledge-only", "kind": "conjecture", "notes": "Research anchor, not an ordinary success-metric target."},
    {"id": "riemann-zeta-function", "canonical_name": "Riemann zeta function", "display_name": "Riemann zeta function and meromorphic continuation", "aliases": ["zeta function"], "statement": "The Dirichlet series sum n^(-s), initially defined for real part greater than 1, extends meromorphically with a simple pole at 1.", "authors": ["Bernhard Riemann"], "year": 1859, "source_ids": ["riemann-1859", "bombieri-rh"], "relationship_to_rh": {"class": "definition/foundation", "direction": "foundation-for-RH", "source_ids": ["riemann-1859"]}, "prerequisites": [], "topic_tags": ["zeta", "analytic-continuation"], "formalization_status": "mathlib", "formalization": {"repository": "mathlib", "note": "Specific pinned declarations are separate atlas entries."}, "verification_status": "verified-in-pinned-mathlib", "candidate_role": "knowledge-only", "kind": "theorem-family", "notes": "Foundation family; source-specific formal identities are preserved separately."},
    {"id": "zeta-functional-equation", "canonical_name": "Riemann zeta functional equation", "display_name": "Zeta functional equation", "aliases": [], "statement": "The completed zeta function is invariant under s mapping to 1-s.", "authors": ["Bernhard Riemann"], "year": 1859, "source_ids": ["riemann-1859", "bombieri-rh"], "relationship_to_rh": {"class": "prerequisite", "direction": "entry-to-RH-prerequisite", "source_ids": ["riemann-1859"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["functional-equation", "zeta"], "formalization_status": "mathlib", "formalization": {"repository": "mathlib"}, "verification_status": "verified-in-pinned-mathlib", "candidate_role": "training-source", "kind": "theorem", "notes": "Core analytic symmetry behind the critical strip."},
    {"id": "zeta-euler-product", "canonical_name": "Euler product for zeta", "display_name": "Euler product for the Riemann zeta function", "aliases": [], "statement": "For real part greater than 1, zeta equals the product over primes of (1-p^(-s))^(-1).", "authors": ["Leonhard Euler"], "year": 1737, "source_ids": ["davenport-mnt"], "relationship_to_rh": {"class": "prerequisite", "direction": "entry-to-RH-prerequisite", "source_ids": ["davenport-mnt"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["Euler-product", "primes"], "formalization_status": "mathlib", "formalization": {"repository": "mathlib"}, "verification_status": "verified-in-pinned-mathlib", "candidate_role": "training-source", "kind": "theorem", "notes": "Connects zeta to primes and gives nonvanishing in the initial half-plane."},
    {"id": "prime-number-theorem", "canonical_name": "Prime number theorem", "display_name": "Prime number theorem", "aliases": ["PNT"], "statement": "The prime-counting function pi(x) is asymptotic to x/log x.", "authors": ["Jacques Hadamard", "Charles Jean de la Vallee Poussin"], "year": 1896, "source_ids": ["davenport-mnt"], "relationship_to_rh": {"class": "partial-progress", "direction": "weaker-than-RH", "source_ids": ["davenport-mnt"]}, "prerequisites": ["zeta-euler-product", "classical-zero-free-region"], "topic_tags": ["prime-counting", "PNT"], "formalization_status": "external-lean", "formalization": {"repository": "PNT+", "note": "Specific pinned declarations are separate atlas entries."}, "verification_status": "verified-in-pinned-native-project", "candidate_role": "training-source", "kind": "theorem", "notes": "PNT is much weaker than RH but central to the specialization bubble."},
    {"id": "explicit-formula", "canonical_name": "Riemann explicit formula", "display_name": "Explicit formula for prime-counting functions", "aliases": ["von Mangoldt explicit formula"], "statement": "Weighted prime-counting functions are expressed using the pole and zeros of zeta plus explicit correction terms.", "authors": ["Bernhard Riemann", "Hans von Mangoldt"], "year": 1895, "source_ids": ["riemann-1859", "titchmarsh-zeta"], "relationship_to_rh": {"class": "prerequisite", "direction": "bridge-between-zeros-and-primes", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["riemann-zeta-function", "riemann-von-mangoldt-zero-count"], "topic_tags": ["explicit-formula", "von-Mangoldt"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-complete-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem-family", "notes": "High-value missing formal bridge."},
    {"id": "riemann-von-mangoldt-zero-count", "canonical_name": "Riemann-von Mangoldt zero-counting formula", "display_name": "Riemann-von Mangoldt zero-counting formula", "aliases": [], "statement": "The number of nontrivial zeta zeros up to height T has main term T/(2*pi) log(T/(2*pi)) - T/(2*pi), with a logarithmic error.", "authors": ["Bernhard Riemann", "Hans von Mangoldt"], "year": 1905, "source_ids": ["titchmarsh-zeta"], "relationship_to_rh": {"class": "prerequisite", "direction": "entry-to-RH-prerequisite", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["zeta-functional-equation"], "topic_tags": ["zero-counting", "zeta-zeros"], "formalization_status": "literature-only", "formalization": null, "verification_status": "partial-components-only-full-formula-not-verified", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Crude zero-count and argument-principle components are accepted as separate entries; the complete formula is not verified in Lean."},
    {"id": "von-koch-prime-error", "canonical_name": "von Koch prime-counting error criterion", "display_name": "von Koch RH criterion for pi(x)", "aliases": [], "statement": "RH is equivalent to pi(x) = Li(x) + O(sqrt(x) log x).", "authors": ["Helge von Koch"], "year": 1901, "source_ids": ["titchmarsh-zeta", "bombieri-rh"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["explicit-formula"], "topic_tags": ["prime-counting", "error-term", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Direction is attributed, not inferred from topical similarity."},
    {"id": "psi-error-criterion", "canonical_name": "Chebyshev psi error criterion", "display_name": "RH criterion via Chebyshev psi", "aliases": [], "statement": "RH is equivalent to psi(x) = x + O(x^(1/2) log(x)^2).", "authors": [], "year": null, "source_ids": ["titchmarsh-zeta"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["explicit-formula"], "topic_tags": ["Chebyshev-psi", "error-term", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "A natural clean future formalization target."},
    {"id": "mobius-summatory-criterion", "canonical_name": "Mobius summatory criterion", "display_name": "RH criterion via the Mertens function", "aliases": ["Mertens function criterion"], "statement": "RH is equivalent to M(x) = O(x^(1/2+epsilon)) for every positive epsilon.", "authors": [], "year": null, "source_ids": ["titchmarsh-zeta"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["zeta-euler-product"], "topic_tags": ["Mobius", "Mertens-function", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "foundations-only", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Do not confuse available Mobius lemmas with a formal proof of the criterion."},
    {"id": "mertens-conjecture", "canonical_name": "Mertens conjecture", "display_name": "Mertens conjecture", "aliases": [], "statement": "The historical conjecture |M(x)| < sqrt(x) is false, although it would imply RH.", "authors": ["Franz Mertens"], "year": 1897, "source_ids": ["titchmarsh-zeta"], "relationship_to_rh": {"class": "implies-RH", "direction": "entry-implies-RH", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["mobius-summatory-criterion"], "topic_tags": ["Mobius", "disproved-conjecture"], "formalization_status": "literature-only", "formalization": null, "verification_status": "disproved", "candidate_role": "knowledge-only", "kind": "disproved-conjecture", "notes": "Included to prevent a false criterion from being treated as an open theorem target."},
    {"id": "riesz-criterion", "canonical_name": "Riesz criterion", "display_name": "Riesz criterion for RH", "aliases": [], "statement": "RH is equivalent to a specified x^(1/4+epsilon) growth bound for the Riesz entire function built from zeta values.", "authors": ["Marcel Riesz"], "year": 1916, "source_ids": ["baez-duarte-2003"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["baez-duarte-2003"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["Riesz", "entire-functions", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Source statement should be consulted before formalization for exact normalization."},
    {"id": "baez-duarte-criterion", "canonical_name": "Baez-Duarte criterion", "display_name": "Baez-Duarte sequence criterion", "aliases": [], "statement": "RH is equivalent to an asymptotic order condition on finite rational combinations of zeta values at positive even integers.", "authors": ["Luis Baez-Duarte"], "year": 2003, "source_ids": ["baez-duarte-2003"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["baez-duarte-2003"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["zeta-values", "sequence-criterion", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Finite-sum formulation may be attractive for staged formalization."},
    {"id": "nyman-beurling-criterion", "canonical_name": "Nyman-Beurling criterion", "display_name": "Nyman-Beurling functional-analytic criterion", "aliases": [], "statement": "RH is equivalent to a closure statement for a span of fractional-part functions in an L2 space.", "authors": ["Bertil Nyman", "Arne Beurling"], "year": 1955, "source_ids": ["baez-duarte-2002"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["baez-duarte-2002"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["functional-analysis", "approximation", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Requires substantial measure and Hilbert-space infrastructure."},
    {"id": "li-criterion", "canonical_name": "Li criterion", "display_name": "Li positivity criterion", "aliases": [], "statement": "RH is equivalent to nonnegativity of every Li coefficient associated with the completed zeta function.", "authors": ["Xian-Jin Li"], "year": 1997, "source_ids": ["li-1997"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["li-1997"]}, "prerequisites": ["riemann-von-mangoldt-zero-count"], "topic_tags": ["derivative-criterion", "zeros", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "An important derivative/zero criterion absent from located Lean sources."},
    {"id": "robin-criterion", "canonical_name": "Robin criterion", "display_name": "Robin divisor-sum criterion", "aliases": [], "statement": "RH is equivalent to sigma(n) < exp(gamma) n log log n for every integer n greater than 5040.", "authors": ["Guy Robin"], "year": 1984, "source_ids": ["robin-1984"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["robin-1984"]}, "prerequisites": [], "topic_tags": ["divisor-sum", "arithmetic-function", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Finite exceptional boundary is part of the exact statement."},
    {"id": "lagarias-criterion", "canonical_name": "Lagarias criterion", "display_name": "Lagarias elementary RH criterion", "aliases": [], "statement": "RH is equivalent to a harmonic-number and divisor-sum inequality for every positive integer.", "authors": ["Jeffrey Lagarias"], "year": 2002, "source_ids": ["lagarias-2002"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["lagarias-2002"]}, "prerequisites": ["robin-criterion"], "topic_tags": ["harmonic-numbers", "divisor-sum", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Potentially approachable after Robin infrastructure."},
    {"id": "speiser-criterion", "canonical_name": "Speiser theorem", "display_name": "Speiser derivative-zero criterion", "aliases": [], "statement": "RH is equivalent to the derivative of zeta having no nonreal zero with real part less than 1/2.", "authors": ["Andreas Speiser"], "year": 1934, "source_ids": ["titchmarsh-zeta"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "bidirectional", "source_ids": ["titchmarsh-zeta"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["zeta-derivative", "zeros", "equivalent-criterion"], "formalization_status": "literature-only", "formalization": null, "verification_status": "not-located-as-Lean-proof", "candidate_role": "formalize-in-lean", "kind": "theorem", "notes": "Derivative-zero relation requires careful multiplicity conventions."},
    {"id": "debruijn-newman", "canonical_name": "De Bruijn-Newman constant", "display_name": "De Bruijn-Newman criterion", "aliases": [], "statement": "For the heat-flow deformation of xi there is a constant Lambda; RH is equivalent to Lambda <= 0, while Lambda >= 0 is now proved.", "authors": ["Nicolaas de Bruijn", "Charles Newman", "Brad Rodgers", "Terence Tao"], "year": 2018, "source_ids": ["rodgers-tao-2018"], "relationship_to_rh": {"class": "equivalent-to-RH", "direction": "RH-equivalent-to-Lambda-at-most-zero", "source_ids": ["rodgers-tao-2018"]}, "prerequisites": ["riemann-zeta-function"], "topic_tags": ["heat-flow", "xi-function", "partial-progress"], "formalization_status": "literature-only", "formalization": null, "verification_status": "lower-bound-proved-RH-open", "candidate_role": "knowledge-only", "kind": "theorem-and-open-bound", "notes": "Records both the equivalence and the proved complementary bound without conflating them."},
    {"id": "classical-zero-free-region", "canonical_name": "Classical zeta zero-free region", "display_name": "Classical zero-free region near Re(s)=1", "aliases": [], "statement": "Zeta has no zeros in a region Re(s) >= 1 - c/log(|Im(s)|) for suitable positive constants and sufficiently large height.", "authors": ["Charles Jean de la Vallee Poussin"], "year": 1899, "source_ids": ["davenport-mnt"], "relationship_to_rh": {"class": "partial-progress", "direction": "weaker-than-RH", "source_ids": ["davenport-mnt"]}, "prerequisites": ["zeta-euler-product"], "topic_tags": ["zero-free-region", "PNT"], "formalization_status": "external-lean", "formalization": {"repository": "PNT+"}, "verification_status": "verified-components-in-native-project", "candidate_role": "training-source", "kind": "theorem", "notes": "Exact external declarations and constants are preserved in source-specific entries."},
