  "riemann_bubble_classes": [
    "core",
    "premise-1",
    "premise-2",
    "user-1",
    "user-2",
    "source-neighborhood"
  ],
  "relevance_distance": {
    "core": 0,
    "premise-1": 1,
    "premise-2": 2,
    "user-1": 1,
    "user-2": 2,
    "source-neighborhood": "source-neighborhood",
    "number-theory-control": "number-theory-control",
    "component-associated": "component-associated"
